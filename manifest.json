{
  "manifest_version": 3,
  "name": "POS & Kiosk Auto Display Manager",
  "version": "1.0.0",
  "description": "Otomatis memposisikan jendela browser ke layar monitor tertentu dan fullscreen berdasarkan aturan URL untuk kasir/POS dan kiosk.",
  "author": "alfathaannn.id",
  "homepage_url": "https://alfathaannn.id",
  "permissions": [
    "system.display",
    "windows",
    "tabs",
    "storage",
    "webNavigation"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.ttf"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
